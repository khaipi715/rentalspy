---
// Expected-rent tool: pick unit/house and bedrooms, see median rent of new leases and the trend.
interface Props { suburb: { name: string; rent: Record<string, any[]> }; compact?: boolean }
const { suburb, compact = false } = Astro.props;
---
<div class:list={['rent-tool', { compact }]} data-rent={JSON.stringify(suburb.rent)} data-name={suburb.name}>
  <div class="panel" aria-live="polite">
    <div class="lbl">What kind of place?</div>
    <div class="seg" data-role="type">
      <button type="button" data-v="unit" aria-pressed="true">Unit or apartment</button>
      <button type="button" data-v="house" aria-pressed="false">House or townhouse</button>
    </div>
    <div class="lbl">Bedrooms</div>
    <div class="seg" data-role="bed">
      <button type="button" data-v="1 bedroom" aria-pressed="false">1</button>
      <button type="button" data-v="2 bedrooms" aria-pressed="true">2</button>
      <button type="button" data-v="3 bedrooms" aria-pressed="false">3</button>
      <button type="button" data-v="4+ bedrooms" aria-pressed="false">4+</button>
    </div>
    <div class="lbl" data-role="reslbl">Expected rent</div>
    <div class="big" data-role="big">—</div>
    <div class="facts" data-role="facts"></div>
    <div class="warn hide" data-role="warn"></div>
  </div>
  {!compact && (
    <div class="panel">
      <h3 data-role="ctitle">How it has changed</h3>
      <div class="fig" data-role="fig"><svg aria-label="Rent trend chart"></svg></div>
      <div class="legend"><span><i style="background:var(--line)"></i>{suburb.name}</span><span><i style="background:var(--mute);height:3px"></i>Adelaide metro, same type</span></div>
    </div>
  )}
</div>
<style>
  .rent-tool { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(16px, 3vw, 32px); }
  .rent-tool.compact { grid-template-columns: 1fr; }
  @media (max-width: 820px) { .rent-tool { grid-template-columns: 1fr; } }
</style>
<script>
  import { money, cnt, qName, esc, type Point } from '../lib/format';
  for (const root of document.querySelectorAll<HTMLElement>('.rent-tool')) {
    const rent = JSON.parse(root.dataset.rent || '{}') as Record<string, Point[]>;
    const name = root.dataset.name || '';
    const q = (r: string) => root.querySelector<HTMLElement>(`[data-role="${r}"]`)!;
    let type = 'unit', bed = '2 bedrooms';
    const bedLbl: Record<string, string> = { '1 bedroom': '1', '2 bedrooms': '2', '3 bedrooms': '3', '4+ bedrooms': '4+' };
    // default to whatever has the most recent data
    if (!(rent['unit|2 bedrooms'] || []).some((p) => p[2] != null)) { type = 'house'; bed = '3 bedrooms'; }
    let current: Point[] = [];
    const press = (role: string, v: string) => q(role).querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
    q('type').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) { type = b.dataset.v!; render(); } });
    q('bed').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) { bed = b.dataset.v!; render(); } });
    function render() {
      press('type', type); press('bed', bed);
      const s = rent[`${type}|${bed}`] || [];
      current = s;
      const lt = [...s].reverse().find((p) => p[2] != null);
      const nb = parseInt(bed) || 4;
      const warn = q('warn');
      if (!lt) {
        q('big').innerHTML = '<span style="font-size:28px">No recent data</span>';
        q('facts').innerHTML = '';
        warn.classList.remove('hide');
        warn.textContent = `No ${type}s with ${bedLbl[bed]} bedroom${nb > 1 ? 's' : ''} were leased in ${name} in the last few years. Try another size.`;
        draw(); return;
      }
      const isLatest = lt[0] === s[s.length - 1][0];
      q('reslbl').textContent = isLatest ? `Expected rent for a new lease, ${qName(lt[0])}` : `Expected rent (latest data: ${qName(lt[0])})`;
      q('big').innerHTML = `${money(lt[2])}<small> /week</small>`;
      const diff = lt[3] != null ? Math.round(lt[2]! - lt[3]) : null;
      const rows: [string, string][] = [
        ['Adelaide metro, same type', money(lt[3]) + (diff != null ? ` (${diff >= 0 ? '+' : '−'}$${Math.abs(diff)} here)` : '')],
        ['New leases that quarter', cnt(lt[1])],
        ['Per month (approx.)', money((lt[2]! * 52) / 12)],
      ];
      if (nb > 1) rows.push([`Per person if ${nb} share`, money(lt[2]! / nb) + ' /week']);
      const first = s.find((p) => p[2] != null);
      if (first && first[0] !== lt[0]) { const pc = Math.round((lt[2]! / first[2]! - 1) * 100); rows.push([`Change since ${qName(first[0])}`, (pc >= 0 ? '+' : '') + pc + '%']); }
      q('facts').innerHTML = rows.map((r) => `<div><span>${esc(r[0])}</span><b>${esc(r[1])}</b></div>`).join('');
      const few = lt[1] === '*' || (typeof lt[1] === 'number' && lt[1] < 10);
      const stale = s.findIndex((p) => p[0] === lt[0]) < s.length - 4;
      warn.classList.toggle('hide', !few && !stale);
      warn.textContent = stale ? `This figure is from ${qName(lt[0])}, over a year ago, because no recent leases of this kind were recorded. Rents have likely risen since.`
        : few ? 'Very few leases of this kind were signed, so this figure is rough. Use it as a guide, not a quote.' : '';
      const t = root.querySelector('[data-role="ctitle"]');
      if (t) t.textContent = `${type === 'unit' ? 'Units' : 'Houses'}, ${bedLbl[bed]} bedroom${nb > 1 ? 's' : ''}: median rent over time`;
      draw();
    }
    const qx = (qq: string) => { const [y, m] = qq.split('-').map(Number); return y + (m - 1.5) / 12; };
    function draw() {
      const svg = root.querySelector<SVGSVGElement>('[data-role="fig"] svg');
      if (!svg) return;
      const W = svg.clientWidth, H = svg.clientHeight;
      if (!W || !current.length) { svg.innerHTML = ''; return; }
      const pts = current.filter((p) => p[2] != null), mp = current.filter((p) => p[3] != null);
      const vals = [...pts.map((p) => +p[2]!), ...mp.map((p) => +p[3]!)];
      if (!vals.length) { svg.innerHTML = ''; return; }
      let lo = Math.floor(Math.min(...vals) / 50) * 50, hi = Math.ceil(Math.max(...vals) / 50) * 50;
      if (hi === lo) hi += 50;
      const pl = W < 520 ? 42 : 52, pr = 14, pt = 18, pb = 30;
      const x0 = qx(current[0][0]), x1 = qx(current[current.length - 1][0]);
      const X = (qq: string) => pl + ((qx(qq) - x0) / (x1 - x0)) * (W - pl - pr);
      const Y = (v: number) => pt + (1 - (v - lo) / (hi - lo)) * (H - pt - pb);
      const step = (hi - lo) / 50 > 6 ? 100 : 50;
      let g = '';
      for (let v = lo; v <= hi; v += step) g += `<line x1="${pl}" x2="${W - pr}" y1="${Y(v)}" y2="${Y(v)}" stroke="var(--rule)"/><text x="${pl - 8}" y="${Y(v) + 4}" text-anchor="end" font-size="12" fill="var(--mute)">$${v}</text>`;
      for (let y = Math.ceil(x0); y <= x1; y++) { const xx = pl + ((y - x0) / (x1 - x0)) * (W - pl - pr); g += `<text x="${xx}" y="${H - 8}" text-anchor="middle" font-size="12" fill="var(--mute)">${y}</text>`; }
      const path = (a: Point[], k: 2 | 3) => a.map((p, i) => (i ? 'L' : 'M') + X(p[0]).toFixed(1) + ',' + Y(+p[k]!).toFixed(1)).join('');
      g += `<path d="${path(mp, 3)}" fill="none" stroke="var(--mute)" stroke-width="2" stroke-dasharray="5 4"/>`;
      g += `<path d="${path(pts, 2)}" fill="none" stroke="var(--line)" stroke-width="3"/>`;
      g += pts.map((p) => `<circle cx="${X(p[0])}" cy="${Y(+p[2]!)}" r="${p[1] === '*' ? 3.5 : 4.5}" fill="${p[1] === '*' ? 'var(--card)' : 'var(--line)'}" stroke="var(--line)" stroke-width="2"><title>${esc(qName(p[0]))}: ${money(p[2])} (${cnt(p[1])} leases)</title></circle>`).join('');
      const lp = pts[pts.length - 1];
      if (lp) g += `<text x="${Math.min(X(lp[0]), W - pr)}" y="${Y(+lp[2]!) - 12}" text-anchor="end" font-size="13" font-weight="700" fill="var(--line)">${money(lp[2])}</text>`;
      svg.innerHTML = g;
    }
    const fig = root.querySelector('[data-role="fig"]');
    if (fig) new ResizeObserver(draw).observe(fig);
    render();
  }
</script>
